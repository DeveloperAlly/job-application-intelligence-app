# Career OS coordinator runtime
CAREER_OS_AGENT=claude
CAREER_OS_WIP=3
CAREER_OS_POLL_SECONDS=60
CAREER_OS_BASE_BRANCH=main

# REQUIRED: configure this once for the local Herdr CLI installed on this machine.
# It must launch the selected agent persistently in Herdr for the supplied cwd
# and task packet. Keep all four placeholders.
#
# Available placeholders:
#   {cwd}         shell-quoted worktree path
#   {agent}       shell-quoted agent name
#   {prompt_file} shell-quoted TASK.md path
#   {issue}       GitHub issue number
#
# Example SHAPE ONLY — replace with the exact local Herdr command after checking
# `herdr ... --help`; the coordinator deliberately fails closed rather than
# guessing CLI flags.
HERDR_DISPATCH_TEMPLATE='REPLACE_WITH_LOCAL_HERDR_COMMAND_USING_{cwd}_{agent}_{prompt_file}_{issue}'
